    <!-- FIXED BOTTOM INSTAGRAM NAVIGATION BAR -->
    <nav class="h-14 border-t backdrop-blur-md flex items-center justify-around px-1 z-30 fixed bottom-0 inset-x-0 transition-colors" id="bottom-nav">
        <button id="tab-profile" class="nav-btn flex flex-col items-center justify-center flex-1 py-1 text-sky-500 transition cursor-pointer" data-tab="profile">
