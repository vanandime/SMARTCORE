    <!-- Modal CV & Detail -->
    <div id="modal-container" class="fixed inset-0 bg-black/60 backdrop-blur-xs hidden items-center justify-center z-50 p-4">
        <div class="theme-card border rounded-3xl max-w-md w-full p-5 shadow-2xl space-y-3 max-h-[85vh] overflow-y-auto animate-smooth">
            <div class="flex items-center justify-between border-b border-neutral-300 dark:border-neutral-800 pb-2.5">
                <h3 id="modal-title" class="font-bold text-xs">Information Details</h3>
                <button id="close-modal" class="opacity-70 hover:opacity-100 p-1 cursor-pointer"><i class="fa-solid fa-xmark text-sm"></i></button>
            </div>
            <div id="modal-content" class="text-xs leading-relaxed space-y-2 font-semibold opacity-90"></div>
            <button id="close-modal-btn" class="w-full bg-sky-500 hover:bg-sky-600 text-white py-2 rounded-xl text-xs font-bold transition shadow-xs cursor-pointer">Close</button>
        </div>
    </div>

    <!-- JavaScript Application Logic -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Audio Background Handling with 3 Tracks
            const audio = document.getElementById('bg-audio');
            audio.volume = 0.4;
            let musicPlaying = false;

            const musicSelector = document.getElementById('music-selector');
            audio.src = musicSelector.value;

            musicSelector.addEventListener('change', () => {
                audio.src = musicSelector.value;
                if (musicPlaying) audio.play().catch(e => {});
            });

            const toggleMusic = () => {
                if (musicPlaying) {
                    audio.pause();
                    musicPlaying = false;
                    document.getElementById('sidebar-music-label').textContent = 'Status: Muted';
                    document.getElementById('sidebar-music-toggle').textContent = 'Play Music';
                    document.getElementById('sidebar-music-toggle').className = 'px-3 py-1.5 rounded-lg text-xs font-bold bg-sky-500 hover:bg-sky-600 text-white transition cursor-pointer shadow-xs';
                } else {
                    audio.play().then(() => {
                        musicPlaying = true;
                        document.getElementById('sidebar-music-label').textContent = 'Status: Playing';
                        document.getElementById('sidebar-music-toggle').textContent = 'Stop Music';
                        document.getElementById('sidebar-music-toggle').className = 'px-3 py-1.5 rounded-lg text-xs font-bold bg-rose-500 hover:bg-rose-600 text-white transition cursor-pointer shadow-xs';
                    }).catch(e => console.log("Autoplay restriction"));
                }
            };

            document.getElementById('sidebar-music-toggle').addEventListener('click', toggleMusic);

            const startAudioOnce = () => {
                if (!musicPlaying) {
                    audio.play().then(() => {
                        musicPlaying = true;
                        document.getElementById('sidebar-music-label').textContent = 'Status: Playing';
                        document.getElementById('sidebar-music-toggle').textContent = 'Stop Music';
                        document.getElementById('sidebar-music-toggle').className = 'px-3 py-1.5 rounded-lg text-xs font-bold bg-rose-500 hover:bg-rose-600 text-white transition cursor-pointer shadow-xs';
                    }).catch(e => {});
                }
                window.removeEventListener('click', startAudioOnce);
                window.removeEventListener('touchstart', startAudioOnce);
            };
            window.addEventListener('click', startAudioOnce);
            window.addEventListener('touchstart', startAudioOnce);

            document.getElementById('volume-slider').addEventListener('input', (e) => {
                audio.volume = e.target.value;
            });

            // Sidebar Settings Controls
            const sidebar = document.getElementById('settings-sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            const openSidebar = document.getElementById('open-sidebar-btn');
            const closeSidebar = document.getElementById('close-sidebar-btn');

            const toggleSidebar = (show) => {
                if (show) {
                    overlay.classList.remove('hidden');
                    sidebar.classList.remove('translate-x-full');
                } else {
                    sidebar.classList.add('translate-x-full');
                    setTimeout(() => overlay.classList.add('hidden'), 300);
                }
            };

            openSidebar.addEventListener('click', (e) => { e.stopPropagation(); toggleSidebar(true); });
            closeSidebar.addEventListener('click', () => toggleSidebar(false));
            overlay.addEventListener('click', () => toggleSidebar(false));

            // Theme Customization
            const savedTheme = localStorage.getItem('executive_theme') || 'theme-clean';
            document.body.className = `${savedTheme} font-['Plus_Jakarta_Sans',sans-serif] min-h-screen flex flex-col selection:bg-pink-500 selection:text-white transition-colors duration-300`;

            document.querySelectorAll('.theme-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const theme = btn.getAttribute('data-theme');
                    document.body.className = `${theme} font-['Plus_Jakarta_Sans',sans-serif] min-h-screen flex flex-col selection:bg-pink-500 selection:text-white transition-colors duration-300`;
                    localStorage.setItem('executive_theme', theme);
                    toggleSidebar(false);
                });
            });

            // Data Backup & Recovery (Export / Import JSON)
            document.getElementById('export-data-btn').addEventListener('click', () => {
                const backupData = {
                    notes: localStorage.getItem('exec_suite_notes') || '',
                    tasks: JSON.parse(localStorage.getItem('exec_suite_tasks') || '[]'),
                    finance: JSON.parse(localStorage.getItem('exec_suite_finance') || '[]'),
                    chat: JSON.parse(localStorage.getItem('exec_suite_chat_danis') || '[]')
                };
                const blob = new Blob([JSON.stringify(backupData, null, 2)], { type: 'json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `Danis_Vanandi_Backup_${new Date().toISOString().slice(0,10)}.json`;
                a.click();
            });

            document.getElementById('import-file-input').addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = (event) => {
                    try {
                        const data = JSON.parse(event.target.result);
                        if (data.notes !== undefined) localStorage.setItem('exec_suite_notes', data.notes);
                        if (data.tasks) localStorage.setItem('exec_suite_tasks', JSON.stringify(data.tasks));
                        if (data.finance) localStorage.setItem('exec_suite_finance', JSON.stringify(data.finance));
                        if (data.chat) localStorage.setItem('exec_suite_chat_danis', JSON.stringify(data.chat));
                        alert('Data successfully restored! Reloading page...');
                        location.reload();
                    } catch (err) {
                        alert('Invalid backup file format.');
                    }
                };
                reader.readAsText(file);
            });

            // Persistent Tabs Management (Keeps active tab on reload)
            const views = {
                profile: document.getElementById('view-profile'),
                chat: document.getElementById('view-chat'),
                notes: document.getElementById('view-notes'),
                tasks: document.getElementById('view-tasks'),
                finance: document.getElementById('view-finance')
            };
            const navButtons = {
                profile: document.getElementById('tab-profile'),
                chat: document.getElementById('tab-chat'),
                notes: document.getElementById('tab-notes'),
                tasks: document.getElementById('tab-tasks'),
                finance: document.getElementById('tab-finance')
            };

            function switchTab(activeKey, save = true) {
                Object.keys(views).forEach(key => {
                    if (key === activeKey) {
                        views[key].classList.remove('hidden');
                        views[key].classList.add('block');
                        if(navButtons[key]) {
                            navButtons[key].classList.remove('opacity-60');
                            navButtons[key].classList.add('text-sky-500');
                        }
                    } else {
                        views[key].classList.remove('block');
                        views[key].classList.add('hidden');
                        if(navButtons[key]) {
                            navButtons[key].classList.add('opacity-60');
                            navButtons[key].classList.remove('text-sky-500');
                        }
                    }
                });
                if (save) localStorage.setItem('exec_active_tab', activeKey);
                window.scrollTo(0, 0);
            }

            Object.keys(navButtons).forEach(key => {
                navButtons[key].addEventListener('click', () => switchTab(key));
            });

            const initialTab = localStorage.getItem('exec_active_tab') || 'profile';
            switchTab(initialTab, false);

            // AI Chat Assistant Engine (Hybrid Stable with Top Auto-Scroll)
            const chatContainer = document.getElementById('chat-container');
            const chatForm = document.getElementById('chat-form');
            const userInput = document.getElementById('user-input');
            const sendBtn = document.getElementById('send-btn');
            
            const OPENROUTER_API_KEY = "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";

            let chatHistory = JSON.parse(localStorage.getItem('exec_suite_chat_danis')) || [];
            if (chatHistory.length > 0) {
                chatHistory.forEach(msg => appendMessage(msg.role, msg.text, false));
            }

            userInput.addEventListener('input', () => {
                sendBtn.disabled = userInput.value.trim().length === 0;
            });

            chatForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const text = userInput.value.trim();
                if (!text) return;

                userInput.value = '';
                sendBtn.disabled = true;

                appendMessage('user', text);
                saveToHistory('user', text);

                const typingId = showTypingIndicator();

                let botResponse = "";
                try {
                    botResponse = await callOpenRouterAPI(text, OPENROUTER_API_KEY);
                } catch (err) {
                    botResponse = getSmartFallbackResponse(text);
                }

                removeTypingIndicator(typingId);
                appendMessage('model', botResponse);
                saveToHistory('model', botResponse);
            });

            async function callOpenRouterAPI(promptText, key) {
                const url = "https://openrouter.ai/api/v1/chat/completions";
                const systemPrompt = `You are the professional virtual assistant for Mohammad Danis Muria Vanandi (vanandi). You answer inquiries about his civil engineering career, project management, and AI research politely and accurately.`;

                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": `Bearer ${key}`,
                        "HTTP-Referer": window.location.origin,
                        "X-Title": "Executive Suite Pro"
                    },
                    body: JSON.stringify({
                        model: "deepseek/deepseek-chat",
                        messages: [
                            { role: "system", content: systemPrompt },
                            { role: "user", content: promptText }
                        ]
                    })
                });

                if (!response.ok) throw new Error('API Error');
                const data = await response.json();
                return data.choices[0].message.content;
            }

            function getSmartFallbackResponse(query) {
                const q = query.toLowerCase();
                if (q.includes('who') || q.includes('name') || q.includes('profile')) {
                    return "Mohammad Danis Muria Vanandi is a Civil Engineer graduated from State Polytechnic of Malang (2021) and an independent AI & NLP Researcher / Project Manager.";
                } else if (q.includes('project') || q.includes('experience') || q.includes('work')) {
                    return "His career includes BPN Land Agency (2021-2022), Sub-District Finance & Logistics (2023-2024), Building Designer & Contractor (2024-2025), and AI/NLP Research (2023-Present).";
                } else if (q.includes('skill')) {
                    return "Hard Skills: 3D/2D Building Design, Supervisor, Project Management, AI/NLP (LLM). Soft Skills: Hardworking, disciplined, and responsible.";
                } else if (q.includes('contact') || q.includes('email') || q.includes('whatsapp')) {
                    return "You can reach Danis via Email at vanandi@proton.me or WhatsApp at +62 898 5160 888.";
                } else {
                    return "Thank you for your inquiry! Mohammad Danis Muria Vanandi specializes in civil engineering and AI research. For direct inquiries, please contact vanandi@proton.me or WhatsApp +62 898 5160 888.";
                }
            }

            function appendMessage(role, text) {
                const isUser = role === 'user';
                const div = document.createElement('div');
                div.className = `flex items-start space-x-2 animate-smooth ${isUser ? 'flex-row-reverse space-x-reverse' : ''}`;

                div.innerHTML = `
                    ${!isUser ? '<div class="w-6 h-6 rounded-full overflow-hidden bg-neutral-200 flex items-center justify-center flex-shrink-0 mt-0.5"><img src="https://blogger.googleusercontent.com/img/a/AVvXsEj3ae4pK3Fkc8MvlhZleBdDcEs9xNiERVEr80vr_yggRuvHvASGknP5Ff-A9e39OcFkDDpwgBKoWiFBukba80LV3AL7X0UxIbSaAk1tdGUSM1D_7uveXovth8y1x9L8godEPCbFnDUUlFtx3UITwrguA-8DKwGwfViqrXKC_xnlNCaNGbBCL8LvObtpuAg=s1601" alt="Danis" class="w-full h-full object-cover"></div>' : ''}
                    <div class="${isUser ? 'bg-sky-500 text-white rounded-tr-none' : 'theme-card border rounded-tl-none'} p-3 rounded-2xl max-w-[80%] text-xs leading-relaxed shadow-xs font-semibold whitespace-pre-line">
                        ${text}
                    </div>
                `;

                chatContainer.appendChild(div);
                chatContainer.scrollTop = 0; // Fix: Scroll to top/latest on new message as requested
            }

            function showTypingIndicator() {
                const id = 'typing-' + Date.now();
                const div = document.createElement('div');
                div.id = id;
                div.className = 'flex items-start space-x-2 animate-smooth';
                div.innerHTML = `
                    <div class="w-6 h-6 rounded-full overflow-hidden bg-neutral-200 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <img src="https://blogger.googleusercontent.com/img/a/AVvXsEj3ae4pK3Fkc8MvlhZleBdDcEs9xNiERVEr80vr_yggRuvHvASGknP5Ff-A9e39OcFkDDpwgBKoWiFBukba80LV3AL7X0UxIbSaAk1tdGUSM1D_7uveXovth8y1x9L8godEPCbFnDUUlFtx3UITwrguA-8DKwGwfViqrXKC_xnlNCaNGbBCL8LvObtpuAg=s1601" alt="Danis" class="w-full h-full object-cover">
                    </div>
                    <div class="theme-card border p-3 rounded-2xl rounded-tl-none flex items-center space-x-1 h-7 shadow-xs">
                        <div class="w-1.5 h-1.5 rounded-full bg-neutral-400 animate-pulse"></div>
                        <div class="w-1.5 h-1.5 rounded-full bg-neutral-400 animate-pulse" style="animation-delay: 0.2s"></div>
                        <div class="w-1.5 h-1.5 rounded-full bg-neutral-400 animate-pulse" style="animation-delay: 0.4s"></div>
                    </div>
                `;
                chatContainer.appendChild(div);
                chatContainer.scrollTop = 0;
                return id;
            }

            function removeTypingIndicator(id) {
                const el = document.getElementById(id);
                if (el) el.remove();
            }

            function saveToHistory(role, text) {
                chatHistory.push({ role, text });
                if (chatHistory.length > 30) chatHistory.shift();
                localStorage.setItem('exec_suite_chat_danis', JSON.stringify(chatHistory));
            }

            // Notes / Scratchpad Logic
            const scratchpad = document.getElementById('scratchpad');
            const clearNotes = document.getElementById('clear-notes');
            scratchpad.value = localStorage.getItem('exec_suite_notes') || '';
            scratchpad.addEventListener('input', () => {
                localStorage.setItem('exec_suite_notes', scratchpad.value);
            });
            clearNotes.addEventListener('click', () => {
                if (confirm('Clear all notes?')) {
                    scratchpad.value = '';
                    localStorage.removeItem('exec_suite_notes');
                }
            });

            // Task Manager with Editing & Reordering Support
            const taskInput = document.getElementById('task-input');
            const addTaskBtn = document.getElementById('add-task-btn');
            const taskList = document.getElementById('task-list');
            const taskCounter = document.getElementById('task-counter');

            let tasks = JSON.parse(localStorage.getItem('exec_suite_tasks')) || [];
            renderTasks();

            addTaskBtn.addEventListener('click', () => {
                const val = taskInput.value.trim();
                if (!val) return;
                tasks.push({ text: val, completed: false });
                taskInput.value = '';
                saveAndRenderTasks();
            });

            function saveAndRenderTasks() {
                localStorage.setItem('exec_suite_tasks', JSON.stringify(tasks));
                renderTasks();
            }

            function renderTasks() {
                taskList.innerHTML = '';
                let completedCount = 0;
                tasks.forEach((t, idx) => {
                    if (t.completed) completedCount++;
                    const div = document.createElement('div');
                    div.className = "theme-card border rounded-xl p-2.5 flex items-center justify-between text-xs shadow-xs gap-2";
                    div.innerHTML = `
                        <div class="flex items-center space-x-2.5 flex-1 min-w-0">
                            <input type="checkbox" ${t.completed ? 'checked' : ''} data-index="${idx}" class="task-checkbox accent-sky-500 w-4 h-4 rounded cursor-pointer flex-shrink-0">
                            <span class="${t.completed ? 'line-through opacity-50' : 'font-semibold'} truncate flex-1 task-text" data-index="${idx}">${t.text}</span>
                        </div>
                        <div class="flex items-center gap-1 flex-shrink-0">
                            <button data-index="${idx}" class="move-up opacity-70 hover:text-sky-500 p-1 cursor-pointer" title="Move Up"><i class="fa-solid fa-arrow-up"></i></button>
                            <button data-index="${idx}" class="move-down opacity-70 hover:text-sky-500 p-1 cursor-pointer" title="Move Down"><i class="fa-solid fa-arrow-down"></i></button>
                            <button data-index="${idx}" class="edit-task opacity-70 hover:text-amber-500 p-1 cursor-pointer" title="Edit"><i class="fa-solid fa-pen"></i></button>
                            <button data-index="${idx}" class="delete-task opacity-70 hover:text-rose-500 p-1 cursor-pointer" title="Delete"><i class="fa-solid fa-trash-can"></i></button>
                        </div>
                    `;
                    taskList.appendChild(div);
                });
                taskCounter.textContent = `${completedCount} of ${tasks.length} Completed`;

                // Task Event Listeners
                document.querySelectorAll('.task-checkbox').forEach(box => {
                    box.addEventListener('change', (e) => {
                        const idx = e.target.getAttribute('data-index');
                        tasks[idx].completed = e.target.checked;
                        saveAndRenderTasks();
                    });
                });

                document.querySelectorAll('.edit-task').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        const idx = e.currentTarget.getAttribute('data-index');
                        const newText = prompt('Edit task:', tasks[idx].text);
                        if (newText !== null && newText.trim() !== '') {
                            tasks[idx].text = newText.trim();
                            saveAndRenderTasks();
                        }
                    });
                });

                document.querySelectorAll('.delete-task').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        const idx = e.currentTarget.getAttribute('data-index');
                        tasks.splice(idx, 1);
                        saveAndRenderTasks();
                    });
                });

                document.querySelectorAll('.move-up').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        const idx = parseInt(e.currentTarget.getAttribute('data-index'));
                        if (idx > 0) {
                            const temp = tasks[idx];
                            tasks[idx] = tasks[idx - 1];
                            tasks[idx - 1] = temp;
                            saveAndRenderTasks();
                        }
                    });
                });

                document.querySelectorAll('.move-down').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        const idx = parseInt(e.currentTarget.getAttribute('data-index'));
                        if (idx < tasks.length - 1) {
                            const temp = tasks[idx];
                            tasks[idx] = tasks[idx + 1];
                            tasks[idx + 1] = temp;
                            saveAndRenderTasks();
                        }
                    });
                });
            }

            // Financial Manager Logic
            const financeForm = document.getElementById('finance-form');
            const finDesc = document.getElementById('fin-desc');
            const finAmount = document.getElementById('fin-amount');
            const finType = document.getElementById('fin-type');
            const financeList = document.getElementById('finance-list');
            const incomeTotal = document.getElementById('income-total');
            const expenseTotal = document.getElementById('expense-total');
            const financeTotal = document.getElementById('finance-total');

            let finances = JSON.parse(localStorage.getItem('exec_suite_finance')) || [];
            renderFinance();

            financeForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const desc = finDesc.value.trim();
                const amount = parseFloat(finAmount.value);
                const type = finType.value;
                if (!desc || isNaN(amount)) return;

                finances.push({ id: Date.now(), desc, amount, type });
                finDesc.value = '';
                finAmount.value = '';
                saveAndRenderFinance();
            });

            function saveAndRenderFinance() {
                localStorage.setItem('exec_suite_finance', JSON.stringify(finances));
                renderFinance();
            }

            function renderFinance() {
                financeList.innerHTML = '';
                let income = 0;
                let expense = 0;

                finances.forEach((item, idx) => {
                    if (item.type === 'income') income += item.amount;
                    else expense += item.amount;

                    const div = document.createElement('div');
                    div.className = "theme-card border rounded-xl p-2.5 flex items-center justify-between text-xs shadow-xs";
                    div.innerHTML = `
                        <div class="flex items-center space-x-2">
                            <span class="${item.type === 'income' ? 'text-emerald-500 font-bold' : 'text-rose-500 font-bold'}">${item.type === 'income' ? '+' : '-'}$${item.amount.toLocaleString()}</span>
                            <span class="font-semibold">${item.desc}</span>
                        </div>
                        <button data-index="${idx}" class="delete-fin opacity-60 hover:text-rose-500 transition cursor-pointer p-1"><i class="fa-solid fa-trash-can"></i></button>
                    `;
                    financeList.appendChild(div);
                });

                const balance = income - expense;
                incomeTotal.textContent = `$${income.toLocaleString()}`;
                expenseTotal.textContent = `$${expense.toLocaleString()}`;
                financeTotal.textContent = `Balance: $${balance.toLocaleString()}`;

                document.querySelectorAll('.delete-fin').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        const idx = e.currentTarget.getAttribute('data-index');
                        finances.splice(idx, 1);
                        saveAndRenderFinance();
                    });
                });
            }

            // Modal Handlers & CV Content
            const modalContainer = document.getElementById('modal-container');
            const modalTitle = document.getElementById('modal-title');
            const modalContent = document.getElementById('modal-content');
            const closeModal = document.getElementById('close-modal');
            const closeModalBtn = document.getElementById('close-modal-btn');

            document.querySelectorAll('.highlight-item').forEach(item => {
                item.addEventListener('click', () => {
                    const topic = item.getAttribute('data-topic');
                    modalTitle.textContent = `Highlight: ${topic.toUpperCase()}`;
                    if (topic === 'experience') {
                        modalContent.innerHTML = `<p>1. PTSL Land Agency / BPN (2021-2022)<br>2. Finance & Logistics Sub-District Office (2023-2024)<br>3. Building Designer & Project Contractor (2024-2025)</p>`;
